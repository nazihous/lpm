# Supports:
#   P9  : Server-9080-M9S-SN7841A08 / Server-9080-M9S-SN02609C8
#   P10 : Server-9080-HEX-SN78C65D8 / Server-9080-HEX-SN78C65C8
#
# P10 HEX vFC mappings (GD1..GD6) are derived from lsnports.txt:
#   GD1/GD2 -> VIO1_M / VIO2_M (GD*_MON_* labels)
#   GD3     -> VIO1 / VIO2     (GD3_* labels; no MON ports)
#   GD4..GD6-> VIO3 / VIO4     (GD*_ labels)
#
# Usage:
#   eaip9_lpm <LPAR> <GD1..GD6> <DESTINATION> [DEST_LPAR_ID]
#   eaip9_srr <LPAR> <GD1..GD6> <DESTINATION> [DEST_LPAR_ID]
#
# Examples:
#   eaip9_lpm P10B_TEST12 GD4 HEX-C8
#   eaip9_lpm P10B_TEST12 GD3 HEX-C8
#   eaip9_lpm P10B_TEST12 GD4 HEX-C8 12
#
# Destination aliases:
#   M9S-A08 | M9S-C8 | HEX-D8 | HEX-C8
#
# DESTINATION is mandatory. DEST_LPAR_ID is optional.
# When DEST_LPAR_ID is omitted, the current source LPAR ID is reused.
#
# Only vFC client slots 70/72/80/82 are generated.

_eai_normalize_destination () {
    case "$1" in
        M9S-A08|A08|Server-9080-M9S-SN7841A08)
            dst=M9S-A08
            ;;
        M9S-C8|Server-9080-M9S-SN02609C8)
            dst=M9S-C8
            ;;
        HEX-D8|D8|78C65D8|Server-9080-HEX-SN78C65D8)
            dst=HEX-D8
            ;;
        HEX-C8|78C65C8|Server-9080-HEX-SN78C65C8)
            dst=HEX-C8
            ;;
        *)
            printf 'Destination inconnue: %s\n' "$1" >&2
            printf 'Destinations valides: M9S-A08, M9S-C8, HEX-D8, HEX-C8\n' >&2
            return 1
            ;;
    esac
}

_eai_default_destination () {
    case "$src" in
        Server-9080-M9S-SN7841A08) dst=M9S-C8 ;;
        Server-9080-M9S-SN02609C8) dst=M9S-A08 ;;
        Server-9080-HEX-SN78C65D8) dst=HEX-C8 ;;
        Server-9080-HEX-SN78C65C8) dst=HEX-D8 ;;
        *)
            printf 'Frame source non supportee: %s\n' "$src" >&2
            return 1
            ;;
    esac
}

_eai_set_source_msp () {
    case "$src:$g" in
        Server-9080-M9S-SN7841A08:[123]) vio_src_msp=P9B_SRV1VIO1 ;;
        Server-9080-M9S-SN7841A08:[456]) vio_src_msp=P9B_SRV1VIO3 ;;
        Server-9080-M9S-SN02609C8:[123])  vio_src_msp=P9B_SRV2VIO1 ;;
        Server-9080-M9S-SN02609C8:[456])  vio_src_msp=P9B_SRV2VIO3 ;;
        Server-9080-HEX-SN78C65D8:[12])    vio_src_msp=P10B_SRV1VIO1_M ;;
        Server-9080-HEX-SN78C65D8:3)       vio_src_msp=P10B_SRV1VIO1 ;;
        Server-9080-HEX-SN78C65D8:[456])   vio_src_msp=P10B_SRV1VIO3 ;;
        Server-9080-HEX-SN78C65C8:[12])    vio_src_msp=P10B_SRV2VIO1_M ;;
        Server-9080-HEX-SN78C65C8:3)       vio_src_msp=P10B_SRV2VIO1 ;;
        Server-9080-HEX-SN78C65C8:[456])   vio_src_msp=P10B_SRV2VIO3 ;;
        *)
            printf 'Combinaison source/GD non supportee: %s / GD%s\n' "$src" "$g" >&2
            return 1
            ;;
    esac
}

