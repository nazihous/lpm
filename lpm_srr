        Server-9080-HEX-SN78C65C8:1|Server-9080-HEX-SN78C65C8:2|Server-9080-HEX-SN78C65C8:3)
            vio1_src=P10B_SRV2VIO1; vio2_src=P10B_SRV2VIO2
            ;;
