_eai_normalize_gd () {
    case "$1" in
        GD1|gd1|1) g=1 ;;
        GD2|gd2|2) g=2 ;;
        GD3|gd3|3) g=3 ;;
        GD4|gd4|4) g=4 ;;
        GD5|gd5|5) g=5 ;;
        GD6|gd6|6) g=6 ;;
        GD1_MON|gd1_mon|1_MON|1_mon|1M|1m) g=1M ;;
        GD2_MON|gd2_mon|2_MON|2_mon|2M|2m) g=2M ;;
        GD4_MON|gd4_mon|4_MON|4_mon|4M|4m) g=4M ;;
        GD5_MON|gd5_mon|5_MON|5_mon|5M|5m) g=5M ;;
        *)
            printf 'GD invalide: %s. Valeurs: GD1..GD6, GD1_MON, GD2_MON, GD4_MON, GD5_MON.\n' "$1" >&2
            return 1
            ;;
    esac
}

_eai_prepare_mapping () {
    lpar=$1
    gd_arg=$2
    requested_dst=$3
    requested_id=$4

    if [ -z "$lpar" ] || [ -z "$gd_arg" ] || [ -z "$requested_dst" ]; then
        return 1
    fi

    _eai_normalize_gd "$gd_arg" || return 1

    if [ -n "$requested_id" ]; then
        case "$requested_id" in
            *[!0-9]*)
                printf 'ID de destination invalide: %s. Une valeur numerique est attendue.\n' "$requested_id" >&2
                return 1
                ;;
        esac
    fi

    src=`lparframelookup "$lpar"` || return 1

    _eai_normalize_destination "$requested_dst" || return 1
    _eai_set_destination_mapping || return 1

    if [ "$src" = "$sys" ]; then
        printf 'La source et la destination sont identiques: %s\n' "$src" >&2
        return 1
    fi

    return 0
}

# One virtual_fc_mappings element: cslot/vio/id/vslot[/pfcs]
_eai_vfc_elem () {
    _cslot=$1; _vio=$2; _vid=$3; _vslot=$4; _pfcs=$5
    if [ -n "$_pfcs" ]; then
        printf '%s' "$_cslot/$G$_vio$N/$_vid/$_vslot/$Y$_pfcs$N"
    else
        printf '%s' "$_cslot/$G$_vio$N/$_vid/$_vslot"
    fi
}

# Slots 70/72 on VIO1, 80/82 on VIO2
_eai_build_vfc_mappings () {
    cslot_70=70; cslot_72=72
    cslot_80=80; cslot_82=82
    vslot_70=1$M$id$N; vslot_72=2$M$id$N
    vslot_80=1$M$id$N; vslot_82=2$M$id$N
    pfcs70=$vio1_fcs1; pfcs72=$vio1_fcs2
    pfcs80=$vio2_fcs1; pfcs82=$vio2_fcs2

    e70=`_eai_vfc_elem "$cslot_70" "$vio1_dst" "$id1" "$vslot_70" "$pfcs70"`
    e72=`_eai_vfc_elem "$cslot_72" "$vio1_dst" "$id1" "$vslot_72" "$pfcs72"`
    e80=`_eai_vfc_elem "$cslot_80" "$vio2_dst" "$id2" "$vslot_80" "$pfcs80"`
    e82=`_eai_vfc_elem "$cslot_82" "$vio2_dst" "$id2" "$vslot_82" "$pfcs82"`
    printf '%s,%s,%s,%s' "$e70" "$e72" "$e80" "$e82"
}

_eai_trim () {
    _t=$1
    _t=${_t#"${_t%%[![:space:]]*}"}
    _t=${_t%"${_t##*[![:space:]]}"}
    printf '%s' "$_t"
}

# Unique vlan_id/source_vswitch pairs from the LPAR's virtual ethernet adapters.
# Args: lpar managed_system [source_vswitch_filter]
# Prints: vid/src_vs,vid/src_vs,...
_eai_lpar_vlan_pairs () {
    _dlpar=$1
    _dframe=$2
    _dsvs=$3
    _pairs=
    _seen=

    _hw=`lshwres -m "$_dframe" -r virtualio --rsubtype eth --level lpar --filter "lpar_names=$_dlpar" -F vswitch,port_vlan_id,addl_vlan_ids` || {
        printf 'Impossible de lire les VLAN du LPAR %s.\n' "$_dlpar" >&2
        return 1
    }

    if [ -z "$_hw" ]; then
        printf 'Aucun VLAN trouve pour le LPAR %s.\n' "$_dlpar" >&2
        return 1
    fi

    while IFS= read -r _line || [ -n "$_line" ]; do
        _line=${_line%$'\r'}
        _line=`_eai_trim "$_line"`
        [ -z "$_line" ] && continue

        _line_svs=${_line%%,*}
        _rest=${_line#*,}
        if [ "$_rest" = "$_line" ]; then
            continue
        fi
        _line_svs=`_eai_trim "$_line_svs"`
        case "$_line_svs" in
            ''|*/*|*,*)
                continue
                ;;
        esac

        if [ -n "$_dsvs" ] && [ "$_line_svs" != "$_dsvs" ]; then
            continue
        fi

        while [ -n "$_rest" ]; do
            case "$_rest" in
                *,*)
                    _vid=${_rest%%,*}
                    _rest=${_rest#*,}
                    ;;
                *)
                    _vid=$_rest
                    _rest=
                    ;;
            esac
            _vid=`_eai_trim "$_vid"`
            _vid=${_vid#\"}
            _vid=${_vid%\"}
            case "$_vid" in
                ''|none|NONE|null) continue ;;
                *[!0-9]*) continue ;;
            esac
            if [ "$_vid" -lt 1 ] || [ "$_vid" -gt 4094 ]; then
                continue
            fi

            _key="$_line_svs/$_vid"
            case ",$_seen," in
                *",$_key,"*) continue ;;
            esac
            _seen="${_seen:+$_seen,}$_key"
            if [ -z "$_pairs" ]; then
                _pairs="$_vid/$_line_svs"
            else
                _pairs="$_pairs,$_vid/$_line_svs"
            fi
        done
    done <<EOF
$_hw
EOF

    if [ -z "$_pairs" ]; then
        if [ -n "$_dsvs" ]; then
            printf 'Aucun VLAN trouve pour le LPAR %s sur le vswitch %s.\n' "$_dlpar" "$_dsvs" >&2
        else
            printf 'Aucun VLAN trouve pour le LPAR %s.\n' "$_dlpar" >&2
        fi
        return 1
    fi

    printf '%s\n' "$_pairs"
}

# Build optional -i fragment: ,vswitch_mappings="vid/src_vs/dst_vs[,...]"
# Args: dest_vswitch vlan_ids [source_vswitch]
# If dest_vswitch is set and vlan_ids is empty, discover all LPAR VLANs
# (uses $lpar and $src from _eai_prepare_mapping). Source defaults to
# ETHERNET0 only when -vid is given without -svs.
_eai_build_vswitch_i_attr () {
    _vs=$1
    _vids=$2
    _svs=$3
    vsw_i=

    if [ -z "$_vs" ] && [ -z "$_vids" ] && [ -z "$_svs" ]; then
        return 0
    fi

    if [ -z "$_vs" ]; then
        printf 'L option -vs est requise pour mapper les VLAN vers un vswitch destination.\n' >&2
        return 1
    fi

    case "$_vs" in
        */*|*,*)
            printf 'Nom de vswitch destination invalide: %s\n' "$_vs" >&2
            return 1
            ;;
    esac

    if [ -n "$_svs" ]; then
        case "$_svs" in
            */*|*,*)
                printf 'Nom de vswitch source invalide: %s\n' "$_svs" >&2
                return 1
                ;;
        esac
    fi

    _pair_spec=
    if [ -z "$_vids" ]; then
        if [ -z "$lpar" ] || [ -z "$src" ]; then
            printf 'Impossible de decouvrir les VLAN: LPAR ou frame source manquant.\n' >&2
            return 1
        fi
        _pair_spec=`_eai_lpar_vlan_pairs "$lpar" "$src" "$_svs"` || return 1
    else
        if [ -z "$_svs" ]; then
            _svs=ETHERNET0
        fi
        _rest=$_vids
        while [ -n "$_rest" ]; do
            case "$_rest" in
                *,*)
                    _vid=${_rest%%,*}
                    _rest=${_rest#*,}
                    ;;
                *)
                    _vid=$_rest
                    _rest=
                    ;;
            esac
            _vid=`_eai_trim "$_vid"`
            case "$_vid" in
                ''|*[!0-9]*)
                    printf 'VLAN ID invalide: %s. Une valeur numerique (1-4094) est attendue.\n' "$_vid" >&2
                    return 1
                    ;;
            esac
            if [ "$_vid" -lt 1 ] || [ "$_vid" -gt 4094 ]; then
                printf 'VLAN ID hors plage: %s (attendu: 1-4094).\n' "$_vid" >&2
                return 1
            fi
            _elem="$_vid/$_svs"
            if [ -z "$_pair_spec" ]; then
                _pair_spec=$_elem
            else
                _pair_spec="$_pair_spec,$_elem"
            fi
        done

        if [ -z "$_pair_spec" ]; then
            printf 'VLAN ID invalide: %s. Une valeur numerique (1-4094) est attendue.\n' "$_vids" >&2
            return 1
        fi
    fi

    _map=
    _rest=$_pair_spec
    while [ -n "$_rest" ]; do
        case "$_rest" in
            *,*)
                _pair=${_rest%%,*}
                _rest=${_rest#*,}
                ;;
            *)
                _pair=$_rest
                _rest=
                ;;
        esac
        _vid=${_pair%%/*}
        _psvs=${_pair#*/}
        _elem="$M$_vid$N/$C$_psvs$N/$G$_vs$N"
        if [ -z "$_map" ]; then
            _map=$_elem
        else
            _map="$_map,$_elem"
        fi
    done

    vsw_i=",vswitch_mappings=\"$_map\""
}

_eai_lpar_state () {
    lssyscfg -r lpar -m "`lparframelookup "$1"`" --filter "lpar_names=$1" -F state
}

_eai_lpar_id () {
    lssyscfg -r lpar -m "`lparframelookup "$1"`" --filter "lpar_names=$1" -F lpar_id
}

_eai_usage_lpm () {
    printf 'Usage: eai_lpm -n <LPAR> -g <GD1..GD6|GD1_MON|GD2_MON|GD4_MON|GD5_MON> -d <DESTINATION> [-t active|inactive] [-msp 1|2] [-id DEST_LPAR_ID] [-vs DEST_VSWITCH [-vid VLAN_ID[,VLAN_ID...]]] [-svs SRC_VSWITCH]\n' >&2
}

_eai_usage_srr () {
    printf 'Usage: eai_srr -n <LPAR> -g <GD1..GD6|GD1_MON|GD2_MON|GD4_MON|GD5_MON> -d <DESTINATION> [-vs DEST_VSWITCH [-vid VLAN_ID[,VLAN_ID...]]] [-svs SRC_VSWITCH]\n' >&2
}

eai_lpm () {
    N=$'\e[0m'; RED=$'\e[1;31m'; Y=$'\e[1;33m'; G=$'\e[1;32m'; MAGENTA=$'\e[1;35m'; C=$'\e[1;36m'; M=$'\e[1;35m'

    local lpar_opt= gd_opt= dst_opt= id_opt= msp_opt=1 type_opt= vs_opt= vid_opt= svs_opt=

    # Backward-compatible positional: eai_lpm <LPAR> <GD> <DEST> [ID]
    if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
        lpar_opt=$1
        gd_opt=$2
        dst_opt=$3
        id_opt=$4
        type_opt=active
        msp_opt=1
    else
        while [ "$#" -gt 0 ]; do
            case "$1" in
                -n) lpar_opt=$2; shift 2 ;;
                -g) gd_opt=$2; shift 2 ;;
                -d) dst_opt=$2; shift 2 ;;
                -id|--id) id_opt=$2; shift 2 ;;
                -msp) msp_opt=$2; shift 2 ;;
                -t) type_opt=$2; shift 2 ;;
                -vs|--vs) vs_opt=$2; shift 2 ;;
                -vid|--vid) vid_opt=$2; shift 2 ;;
                -svs|--svs) svs_opt=$2; shift 2 ;;
                -h|--help)
                    _eai_usage_lpm
                    return 0
                    ;;
                *)
                    printf 'Option inconnue: %s\n' "$1" >&2
                    _eai_usage_lpm
                    return 1
                    ;;
            esac
        done
    fi

    if [ -z "$lpar_opt" ] || [ -z "$gd_opt" ] || [ -z "$dst_opt" ]; then
        _eai_usage_lpm
        return 1
    fi

    case "$msp_opt" in
        1|2) ;;
        *)
            printf 'Valeur -msp invalide: %s (attendu: 1 ou 2)\n' "$msp_opt" >&2
            return 1
            ;;
    esac

    if [ -n "$type_opt" ]; then
        case "$type_opt" in
            active|ACTIVE|a|A) type_opt=active ;;
            inactive|INACTIVE|i|I) type_opt=inactive ;;
            *)
                printf 'Valeur -t invalide: %s (attendu: active ou inactive)\n' "$type_opt" >&2
                return 1
                ;;
        esac
    fi

    _eai_prepare_mapping "$lpar_opt" "$gd_opt" "$dst_opt" "$id_opt" || {
        _eai_usage_lpm
        return 1
    }
    _eai_set_source_msp || return 1

    if [ -n "$requested_id" ]; then
        id=$requested_id
    else
        id=`_eai_lpar_id "$lpar"` || return 1
    fi

    if [ -z "$type_opt" ]; then
        lpar_state=`_eai_lpar_state "$lpar"` || return 1
        case "$lpar_state" in
            Running|running) type_opt=active ;;
            *) type_opt=inactive ;;
        esac
    fi

    vfc=`_eai_build_vfc_mappings`
    _eai_build_vswitch_i_attr "$vs_opt" "$vid_opt" "$svs_opt" || return 1

    if [ "$type_opt" = "inactive" ]; then
        # INACTIVE_LPM
        printf '%s\n' "<migrlpar> -o m -m $C$src$N -t $G$sys$N -p $lpar -i 'dest_lpar_id=$M$id$N,virtual_fc_mappings=\"$vfc\"$vsw_i'"
        return 0
    fi

    # Active LPM
    if [ "$msp_opt" = "2" ]; then
        # ACTLPM_REDUN_MSPS
        printf '%s\n' "<migrlpar> -o m -m $C$src$N -t $G$sys$N -p $lpar --redundantmsps 1 -i 'dest_lpar_id=$M$id$N,virtual_fc_mappings=\"$vfc\"$vsw_i,redundant_msps=\"1/$C$vio1_src$N///$G$vio1_dst$N//,1/$C$vio2_src$N///$G$vio2_dst$N//\"'"
    else
        # ACTLPM_SINGL_MSP
        printf '%s\n' "<migrlpar> -o m -m $C$src$N -t $G$sys$N -p $lpar --redundantmsps 0 -i 'dest_lpar_id=$M$id$N,virtual_fc_mappings=\"$vfc\"$vsw_i,source_msp_name=$C$vio1_src$N,dest_msp_name=$G$vio1_dst$N'"
    fi
}

eai_srr () {
    N=$'\e[0m'; RED=$'\e[1;31m'; Y=$'\e[1;33m'; G=$'\e[1;32m'; MAGENTA=$'\e[1;35m'; C=$'\e[1;36m'; M=$'\e[1;35m'

    local lpar_opt= gd_opt= dst_opt= vs_opt= vid_opt= svs_opt=

    # Backward-compatible positional: eai_srr <LPAR> <GD> <DEST>
    if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
        lpar_opt=$1
        gd_opt=$2
        dst_opt=$3
    else
        while [ "$#" -gt 0 ]; do
            case "$1" in
                -n) lpar_opt=$2; shift 2 ;;
                -g) gd_opt=$2; shift 2 ;;
                -d) dst_opt=$2; shift 2 ;;
                -vs|--vs) vs_opt=$2; shift 2 ;;
                -vid|--vid) vid_opt=$2; shift 2 ;;
                -svs|--svs) svs_opt=$2; shift 2 ;;
                -h|--help)
                    _eai_usage_srr
                    return 0
                    ;;
                *)
                    printf 'Option inconnue: %s\n' "$1" >&2
                    _eai_usage_srr
                    return 1
                    ;;
            esac
        done
    fi

    if [ -z "$lpar_opt" ] || [ -z "$gd_opt" ] || [ -z "$dst_opt" ]; then
        _eai_usage_srr
        return 1
    fi

    _eai_prepare_mapping "$lpar_opt" "$gd_opt" "$dst_opt" "" || {
        _eai_usage_srr
        return 1
    }

    id=`_eai_lpar_id "$lpar"` || return 1
    vfc=`_eai_build_vfc_mappings`
    _eai_build_vswitch_i_attr "$vs_opt" "$vid_opt" "$svs_opt" || return 1

    # SIMPLE REMO REST
    printf '%s\n' "<rrstartlpar> -o restart -m $C$src$N -t $G$sys$N -p $lpar -i 'dest_lpar_id=$M$id$N,shared_proc_pool_name=DefaultPool,virtual_fc_mappings=\"$vfc\"$vsw_i'"
}

# Compatibility aliases
eaip9_lpm () { eai_lpm "$@"; }
eaip9_srr () { eai_srr "$@"; }
