            vio1_src=P10B_SRV2VIO3_M; vio2_src=P10B_SRV2VIO4_M
            ;;
        *)
            printf 'Combinaison source/GD non supportee: %s / GD%s\n' "$src" "$g" >&2
            return 1
            ;;
    esac
}

