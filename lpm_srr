_eai_prepare_mapping () {
    lpar=$1
    gd_arg=$2
    requested_dst=$3
    requested_id=$4

    if [ -z "$lpar" ] || [ -z "$gd_arg" ] || [ -z "$requested_dst" ]; then
        printf 'Usage: %s <LPAR> <GD1..GD6> <M9S-A08|M9S-C8|HEX-D8|HEX-C8> [DEST_LPAR_ID]\n' "$FUNCNAME" >&2
        return 1
    fi

    case "$gd_arg" in
        GD1|gd1|1) g=1 ;;
        GD2|gd2|2) g=2 ;;
        GD3|gd3|3) g=3 ;;
        GD4|gd4|4) g=4 ;;
        GD5|gd5|5) g=5 ;;
        GD6|gd6|6) g=6 ;;
        *)
            printf 'GD invalide: %s. Valeurs autorisees: GD1 a GD6.\n' "$gd_arg" >&2
            return 1
            ;;
    esac

    if [ -n "$requested_id" ]; then
        case "$requested_id" in
            *[!0-9]*)
                printf 'ID de destination invalide: %s. Une valeur numerique est attendue.\n' "$requested_id" >&2
                return 1
                ;;
        esac
    fi

    src=`lparframelookup "$lpar"` || return 1

    _eai_normalize_destination "$requested_dst" || return 1
    _eai_set_destination_mapping || return 1

    if [ "$src" = "$sys" ]; then
        printf 'La source et la destination sont identiques: %s\n' "$src" >&2
        return 1
    fi

    return 0
}

eai_lpm () {
    N=$'\e[0m'; RED=$'\e[1;31m'; Y=$'\e[1;33m'; G=$'\e[1;32m'; MAGENTA=$'\e[1;35m'; C=$'\e[1;36m'; M=$'\e[1;35m'

    lparid () {
        lssyscfg -r lpar -m "`lparframelookup "$1"`" --filter "lpar_names=$1" -F lpar_id
    }

    fpool () {
        pool_sys=`lparframelookup "$1"` || return 1
        default_profile=`lssyscfg -r lpar -m "$pool_sys" --filter "lpar_names=$1" -F default_profile` || return 1
        lssyscfg -r prof -m "$pool_sys" --filter "profile_names=$default_profile,lpar_names=$1" -F shared_proc_pool_name
    }

    _eai_prepare_mapping "$1" "$2" "$3" "$4" || return 1
    _eai_set_source_msp || return 1

    if [ -n "$requested_id" ]; then
        id=$requested_id
    else
        id=`lparid "$lpar"` || return 1
    fi

    pool=`fpool "$lpar"` || return 1

    printf '%s\n' "<migrlpar> -o m -m $C$src$N -t $G$sys$N -p $lpar -i 'dest_lpar_id=$M$id$N,shared_proc_pool_name=$pool,virtual_fc_mappings=\"70/$G$vio1_dst$N/$id1/1$M$id$N/$Y$vio1_fcs1$N,72/$G$vio1_dst$N/$id1/2$M$id$N/$Y$vio1_fcs2$N,80/$G$vio2_dst$N/$id2/1$M$id$N/$Y$vio2_fcs1$N,82/$G$vio2_dst$N/$id2/2$M$id$N/$Y$vio2_fcs2$N\",source_msp_name=$C$vio_src_msp$N,dest_msp_name=$G$vio_dst_msp$N'"
}

eaip9_srr () {
    N=$'\e[0m'; RED=$'\e[1;31m'; Y=$'\e[1;33m'; G=$'\e[1;32m'; MAGENTA=$'\e[1;35m'; C=$'\e[1;36m'; M=$'\e[1;35m'

    lparid () {
        lssyscfg -r lpar -m "`lparframelookup "$1"`" --filter "lpar_names=$1" -F lpar_id
    }

    _eai_prepare_mapping "$1" "$2" "$3" "$4" || return 1

    if [ -n "$requested_id" ]; then
        id=$requested_id
    else
        id=`lparid "$lpar"` || return 1
    fi

    printf '%s\n' "rrstartlpar -o restart -m $C$src$N -t $G$sys$N -p $lpar -i 'dest_lpar_id=$M$id$N,shared_proc_pool_name=DefaultPool,virtual_fc_mappings=\"70/$G$vio1_dst$N/$id1/1$M$id$N/$Y$vio1_fcs1$N,72/$G$vio1_dst$N/$id1/2$M$id$N/$Y$vio1_fcs2$N,80/$G$vio2_dst$N/$id2/1$M$id$N/$Y$vio2_fcs1$N,82/$G$vio2_dst$N/$id2/2$M$id$N/$Y$vio2_fcs2$N\"'"
}
