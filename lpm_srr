_eai_normalize_gd () {
    case "$1" in
        GD1|gd1|1) g=1 ;;
        GD2|gd2|2) g=2 ;;
        GD3|gd3|3) g=3 ;;
        GD4|gd4|4) g=4 ;;
        GD5|gd5|5) g=5 ;;
        GD6|gd6|6) g=6 ;;
        GD1_MON|gd1_mon|1_MON|1_mon|1M|1m) g=1M ;;
        GD2_MON|gd2_mon|2_MON|2_mon|2M|2m) g=2M ;;
        GD4_MON|gd4_mon|4_MON|4_mon|4M|4m) g=4M ;;
        GD5_MON|gd5_mon|5_MON|5_mon|5M|5m) g=5M ;;
        *)
            printf 'GD invalide: %s. Valeurs: GD1..GD6, GD1_MON, GD2_MON, GD4_MON, GD5_MON.\n' "$1" >&2
            return 1
            ;;
    esac
}

_eai_prepare_mapping () {
    lpar=$1
    gd_arg=$2
    requested_dst=$3
    requested_id=$4

    if [ -z "$lpar" ] || [ -z "$gd_arg" ] || [ -z "$requested_dst" ]; then
        return 1
    fi

    _eai_normalize_gd "$gd_arg" || return 1

    if [ -n "$requested_id" ]; then
        case "$requested_id" in
            *[!0-9]*)
                printf 'ID de destination invalide: %s. Une valeur numerique est attendue.\n' "$requested_id" >&2
                return 1
                ;;
        esac
    fi

    src=`lparframelookup "$lpar"` || return 1

    _eai_normalize_destination "$requested_dst" || return 1
    _eai_set_destination_mapping || return 1

    if [ "$src" = "$sys" ]; then
        printf 'La source et la destination sont identiques: %s\n' "$src" >&2
        return 1
    fi

    return 0
}

# One virtual_fc_mappings element: cslot/vio/id/vslot[/pfcs]
_eai_vfc_elem () {
    _cslot=$1; _vio=$2; _vid=$3; _vslot=$4; _pfcs=$5
    if [ -n "$_pfcs" ]; then
        printf '%s' "$_cslot/$G$_vio$N/$_vid/$_vslot/$Y$_pfcs$N"
    else
        printf '%s' "$_cslot/$G$_vio$N/$_vid/$_vslot"
    fi
}

# Order matches runbook: 70,72,71,80,82,81
_eai_build_vfc_mappings () {
    cslot_70=70; cslot_72=72; cslot_71=71
    cslot_80=80; cslot_82=82; cslot_81=81
    vslot_70=1$M$id$N; vslot_72=2$M$id$N; vslot_71=3$M$id$N
    vslot_80=1$M$id$N; vslot_82=2$M$id$N; vslot_81=3$M$id$N
    pfcs70=$vio1_fcs1; pfcs72=$vio1_fcs2; pfcs71=$vio1_fcs3
    pfcs80=$vio2_fcs1; pfcs82=$vio2_fcs2; pfcs81=$vio2_fcs3

    e70=`_eai_vfc_elem "$cslot_70" "$vio1_dst" "$id1" "$vslot_70" "$pfcs70"`
    e72=`_eai_vfc_elem "$cslot_72" "$vio1_dst" "$id1" "$vslot_72" "$pfcs72"`
    e71=`_eai_vfc_elem "$cslot_71" "$vio1_dst" "$id1" "$vslot_71" "$pfcs71"`
    e80=`_eai_vfc_elem "$cslot_80" "$vio2_dst" "$id2" "$vslot_80" "$pfcs80"`
    e82=`_eai_vfc_elem "$cslot_82" "$vio2_dst" "$id2" "$vslot_82" "$pfcs82"`
    e81=`_eai_vfc_elem "$cslot_81" "$vio2_dst" "$id2" "$vslot_81" "$pfcs81"`
    printf '%s,%s,%s,%s,%s,%s' "$e70" "$e72" "$e71" "$e80" "$e82" "$e81"
}

_eai_lpar_state () {
    lssyscfg -r lpar -m "`lparframelookup "$1"`" --filter "lpar_names=$1" -F state
}

_eai_lpar_id () {
    lssyscfg -r lpar -m "`lparframelookup "$1"`" --filter "lpar_names=$1" -F lpar_id
}

_eai_usage_lpm () {
    printf 'Usage: eai_lpm -n <LPAR> -g <GD1..GD6|GD1_MON|GD2_MON|GD4_MON|GD5_MON> -d <DESTINATION> [-t active|inactive] [-msp 1|2] [-id DEST_LPAR_ID]\n' >&2
}

_eai_usage_srr () {
    printf 'Usage: eai_srr -n <LPAR> -g <GD1..GD6|GD1_MON|GD2_MON|GD4_MON|GD5_MON> -d <DESTINATION>\n' >&2
}

eai_lpm () {
    N=$'\e[0m'; RED=$'\e[1;31m'; Y=$'\e[1;33m'; G=$'\e[1;32m'; MAGENTA=$'\e[1;35m'; C=$'\e[1;36m'; M=$'\e[1;35m'

    local lpar_opt= gd_opt= dst_opt= id_opt= msp_opt=1 type_opt=

    # Backward-compatible positional: eai_lpm <LPAR> <GD> <DEST> [ID]
    if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
        lpar_opt=$1
        gd_opt=$2
        dst_opt=$3
        id_opt=$4
        type_opt=active
        msp_opt=1
    else
        while [ "$#" -gt 0 ]; do
            case "$1" in
                -n) lpar_opt=$2; shift 2 ;;
                -g) gd_opt=$2; shift 2 ;;
                -d) dst_opt=$2; shift 2 ;;
                -id|--id) id_opt=$2; shift 2 ;;
                -msp) msp_opt=$2; shift 2 ;;
                -t) type_opt=$2; shift 2 ;;
                -h|--help)
                    _eai_usage_lpm
                    return 0
                    ;;
                *)
                    printf 'Option inconnue: %s\n' "$1" >&2
                    _eai_usage_lpm
                    return 1
                    ;;
            esac
        done
    fi

    if [ -z "$lpar_opt" ] || [ -z "$gd_opt" ] || [ -z "$dst_opt" ]; then
        _eai_usage_lpm
        return 1
    fi

    case "$msp_opt" in
        1|2) ;;
        *)
            printf 'Valeur -msp invalide: %s (attendu: 1 ou 2)\n' "$msp_opt" >&2
            return 1
            ;;
    esac

    if [ -n "$type_opt" ]; then
        case "$type_opt" in
            active|ACTIVE|a|A) type_opt=active ;;
            inactive|INACTIVE|i|I) type_opt=inactive ;;
            *)
                printf 'Valeur -t invalide: %s (attendu: active ou inactive)\n' "$type_opt" >&2
                return 1
                ;;
        esac
    fi

    _eai_prepare_mapping "$lpar_opt" "$gd_opt" "$dst_opt" "$id_opt" || {
        _eai_usage_lpm
        return 1
    }
    _eai_set_source_msp || return 1

    if [ -n "$requested_id" ]; then
        id=$requested_id
    else
        id=`_eai_lpar_id "$lpar"` || return 1
    fi

    if [ -z "$type_opt" ]; then
        lpar_state=`_eai_lpar_state "$lpar"` || return 1
        case "$lpar_state" in
            Running|running) type_opt=active ;;
            *) type_opt=inactive ;;
        esac
    fi

    vfc=`_eai_build_vfc_mappings`

    if [ "$type_opt" = "inactive" ]; then
        # INACTIVE_LPM
        printf '%s\n' "<migrlpar> -o m -m $C$src$N -t $G$sys$N -p $lpar -i 'dest_lpar_id=$M$id$N,virtual_fc_mappings=\"$vfc\"'"
        return 0
    fi

    # Active LPM
    if [ "$msp_opt" = "2" ]; then
        # ACTLPM_REDUN_MSPS
        printf '%s\n' "<migrlpar> -o m -m $C$src$N -t $G$sys$N -p $lpar --redundantmsps 1 -i 'dest_lpar_id=$M$id$N,virtual_fc_mappings=\"$vfc\",redundant_msps=\"1/$C$vio1_src$N///$G$vio1_dst$N//,1/$C$vio2_src$N///$G$vio2_dst$N//\"'"
    else
        # ACTLPM_SINGL_MSP
        printf '%s\n' "<migrlpar> -o m -m $C$src$N -t $G$sys$N -p $lpar --redundantmsps 0 -i 'dest_lpar_id=$M$id$N,virtual_fc_mappings=\"$vfc\",source_msp_name=$C$vio1_src$N,dest_msp_name=$G$vio1_dst$N'"
    fi
}

eai_srr () {
    N=$'\e[0m'; RED=$'\e[1;31m'; Y=$'\e[1;33m'; G=$'\e[1;32m'; MAGENTA=$'\e[1;35m'; C=$'\e[1;36m'; M=$'\e[1;35m'

    local lpar_opt= gd_opt= dst_opt=

    # Backward-compatible positional: eai_srr <LPAR> <GD> <DEST>
    if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
        lpar_opt=$1
        gd_opt=$2
        dst_opt=$3
    else
        while [ "$#" -gt 0 ]; do
            case "$1" in
                -n) lpar_opt=$2; shift 2 ;;
                -g) gd_opt=$2; shift 2 ;;
                -d) dst_opt=$2; shift 2 ;;
                -h|--help)
                    _eai_usage_srr
                    return 0
                    ;;
                *)
                    printf 'Option inconnue: %s\n' "$1" >&2
                    _eai_usage_srr
                    return 1
                    ;;
            esac
        done
    fi

    if [ -z "$lpar_opt" ] || [ -z "$gd_opt" ] || [ -z "$dst_opt" ]; then
        _eai_usage_srr
        return 1
    fi

    _eai_prepare_mapping "$lpar_opt" "$gd_opt" "$dst_opt" "" || {
        _eai_usage_srr
        return 1
    }

    id=`_eai_lpar_id "$lpar"` || return 1
    vfc=`_eai_build_vfc_mappings`

    # SIMPLE REMO REST
    printf '%s\n' "<rrstartlpar> -o restart -m $C$src$N -t $G$sys$N -p $lpar -i 'dest_lpar_id=$M$id$N,shared_proc_pool_name=DefaultPool,virtual_fc_mappings=\"$vfc\"'"
}

# Compatibility aliases
eaip9_lpm () { eai_lpm "$@"; }
eaip9_srr () { eai_srr "$@"; }
